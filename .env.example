DATABASE_URL="postgresql://trc:trc@localhost:5432/the_right_choice?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# Which day counts as "today" on the Daily Stock page (IANA name).
# Without it the app would use the server clock in UTC, so a Lagos shop opening just after
# midnight would be handed the previous day.
APP_TIMEZONE="Africa/Lagos"
